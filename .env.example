# VillageDELI Environment Configuration Example

# Server & Runtime Configuration
PORT=3001
NODE_ENV=production

# Admin Initial Credentials (Change these for your live production store!)
# When set, the super admin account credentials will automatically sync.
ADMIN_EMAIL=admin@villagedeli.in
ADMIN_PASSWORD=VillageDeli@2026!

# Google OAuth 2.0 Client ID (Optional for local development, recommended for live Google popup)
# To obtain: Go to https://console.cloud.google.com/ -> APIs & Services -> Credentials -> Create OAuth Client ID (Web Application)
# Authorized JavaScript origins: https://yourdomain.com
VITE_GOOGLE_CLIENT_ID=
